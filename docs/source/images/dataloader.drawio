<mxfile host="app.diagrams.net">
  <diagram id="dataloader" name="How one rank delivers and checkpoints batches">
    <mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1040" pageHeight="565" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" value="How one rank delivers and checkpoints batches" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=0;spacingRight=0;fontFamily=Helvetica;fontSize=30;fontColor=#193650;fontStyle=1;" vertex="1">
          <mxGeometry x="28" y="15" width="984" height="53" as="geometry" />
        </mxCell>
        <mxCell id="delivery" parent="1" value="Batch delivery" style="text;html=0;strokeColor=none;fillColor=#E9EFF3;align=left;verticalAlign=middle;spacingLeft=0;spacingRight=0;fontFamily=Helvetica;fontSize=18;fontColor=#193650;fontStyle=1;" vertex="1">
          <mxGeometry x="28" y="75" width="984" height="34" as="geometry" />
        </mxCell>
        <mxCell id="worker" parent="1" value="&lt;b&gt;Dataset iterator&lt;/b&gt;&lt;br/&gt;Reads the next batch&lt;br/&gt;in its worker context" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontSize=16;fontColor=#193650;strokeWidth=1.5;strokeColor=#176B70;fillColor=#EAF6F4;" vertex="1">
          <mxGeometry x="28" y="135" width="215" height="86" as="geometry" />
        </mxCell>
        <mxCell id="pin" parent="1" value="&lt;b&gt;Optional pinning&lt;/b&gt;&lt;br/&gt;Pins CPU tensors&lt;br/&gt;in a parent thread" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontSize=16;fontColor=#193650;strokeWidth=1.5;strokeColor=#386998;fillColor=#EDF4FB;" vertex="1">
          <mxGeometry x="279" y="135" width="211" height="86" as="geometry" />
        </mxCell>
        <mxCell id="coordinator" parent="1" value="&lt;b&gt;DataLoader&lt;/b&gt;&lt;br/&gt;Selects a worker FIFO&lt;br/&gt;in round-robin order" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontSize=16;fontColor=#193650;strokeWidth=1.5;strokeColor=#193650;fillColor=#EEF3F8;" vertex="1">
          <mxGeometry x="526" y="135" width="224" height="86" as="geometry" />
        </mxCell>
        <mxCell id="caller" parent="1" value="&lt;b&gt;Training loop&lt;/b&gt;&lt;br/&gt;Receives the next&lt;br/&gt;completed batch" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontSize=16;fontColor=#193650;strokeWidth=1.5;strokeColor=#526B7C;fillColor=#FFFFFF;" vertex="1">
          <mxGeometry x="786" y="135" width="226" height="86" as="geometry" />
        </mxCell>
        <mxCell id="worker-pin" parent="1" edge="1" value="" style="html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#526B7C;strokeWidth=1.6;fontSize=15;fontFamily=Helvetica;fontColor=#193650;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" source="worker" target="pin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pin-loader" parent="1" edge="1" value="" style="html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#526B7C;strokeWidth=1.6;fontSize=15;fontFamily=Helvetica;fontColor=#193650;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" source="pin" target="coordinator">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="loader-training" parent="1" edge="1" value="" style="html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#526B7C;strokeWidth=1.6;fontSize=15;fontFamily=Helvetica;fontColor=#193650;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" source="coordinator" target="caller">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="prefetch" parent="1" value="The loader requests work ahead of delivery. With zero workers, each request runs in the calling thread." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=0;spacingRight=0;fontFamily=Helvetica;fontSize=16;fontColor=#526B7C;fontStyle=0;" vertex="1">
          <mxGeometry x="28" y="237" width="984" height="33" as="geometry" />
        </mxCell>
        <mxCell id="save" parent="1" value="Saving one rank" style="text;html=0;strokeColor=none;fillColor=#E9EFF3;align=left;verticalAlign=middle;spacingLeft=0;spacingRight=0;fontFamily=Helvetica;fontSize=18;fontColor=#193650;fontStyle=1;" vertex="1">
          <mxGeometry x="28" y="296" width="984" height="34" as="geometry" />
        </mxCell>
        <mxCell id="boundary" parent="1" value="&lt;b&gt;Delivery boundary&lt;/b&gt;&lt;br/&gt;Wait for the active next()&lt;br/&gt;before taking the snapshot" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontSize=16;fontColor=#193650;strokeWidth=1.5;strokeColor=#996323;fillColor=#FBF4E9;" vertex="1">
          <mxGeometry x="28" y="352" width="270" height="101" as="geometry" />
        </mxCell>
        <mxCell id="snapshot" parent="1" value="&lt;b&gt;Per-worker checkpoint&lt;/b&gt;&lt;br/&gt;Execution state, pending output&lt;br/&gt;keys and observed end of input" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontSize=16;fontColor=#193650;strokeWidth=1.5;strokeColor=#176B70;fillColor=#EAF6F4;" vertex="1">
          <mxGeometry x="353" y="352" width="320" height="101" as="geometry" />
        </mxCell>
        <mxCell id="rank" parent="1" value="&lt;b&gt;RankState&lt;/b&gt;&lt;br/&gt;Worker checkpoints, next worker&lt;br/&gt;and batch configuration" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontSize=16;fontColor=#193650;strokeWidth=1.5;strokeColor=#193650;fillColor=#EEF3F8;" vertex="1">
          <mxGeometry x="728" y="352" width="284" height="101" as="geometry" />
        </mxCell>
        <mxCell id="boundary-snapshot" parent="1" edge="1" value="" style="html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#526B7C;strokeWidth=1.6;fontSize=15;fontFamily=Helvetica;fontColor=#193650;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" source="boundary" target="snapshot">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="snapshot-rank" parent="1" edge="1" value="" style="html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#526B7C;strokeWidth=1.6;fontSize=15;fontFamily=Helvetica;fontColor=#193650;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" source="snapshot" target="rank">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="resume" parent="1" value="On restore, workers load their snapshots and rebuild undelivered batches from the saved keys." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=0;spacingRight=0;fontFamily=Helvetica;fontSize=16;fontColor=#526B7C;fontStyle=0;" vertex="1">
          <mxGeometry x="28" y="482" width="984" height="37" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
